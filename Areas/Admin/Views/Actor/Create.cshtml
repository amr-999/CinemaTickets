@model ActorVM
@{ ViewData["Title"] = "New Actor"; }
<div class="row justify-content-center"><div class="col-lg-7">
    <div class="card card-section">
        <div class="card-header-section"><i class="fas fa-plus-circle me-2 text-primary"></i>Add Actor</div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Full name…" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Bio" class="form-label fw-semibold"></label>
                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Short biography…"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="ImgFile" class="form-label fw-semibold"></label>
                    <input asp-for="ImgFile" type="file" class="form-control" accept="image/*"
                           onchange="previewImage(this,'imgPreview')" />
                    <img id="imgPreview" src="#" class="actor-preview mt-2" style="display:none" />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
