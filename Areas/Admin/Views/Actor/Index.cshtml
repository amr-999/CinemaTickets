@model CinemaTickets.Helpers.PaginatedList<CinemaTickets.Models.Actor>
@{ ViewData["Title"] = "Actors"; }
<div class="card card-section mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search actors…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Actor</a>
            </div>
        </form>
    </div>
</div>
<div class="row g-4">
    @foreach (var a in Model.Items)
    {
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="card h-100 shadow-sm border-0 text-center">
                @if (!string.IsNullOrEmpty(a.Img))
                { <img src="@a.Img" class="actor-photo mx-auto mt-3" alt="@a.Name" /> }
                else { <div class="actor-photo-placeholder mx-auto mt-3"><i class="fas fa-user"></i></div> }
                <div class="card-body">
                    <h6 class="fw-semibold mb-1">@a.Name</h6>
                    @if (!string.IsNullOrEmpty(a.Bio))
                    { <p class="text-muted small mb-0" style="overflow:hidden;max-height:38px">@a.Bio</p> }
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-warning flex-fill"><i class="fas fa-pen"></i></a>
                    <button class="btn btn-sm btn-outline-danger flex-fill"
                            onclick="confirmDelete('@a.Id','@a.Name','Actor')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    }
    @if (!Model.Items.Any()) { <div class="col-12 text-center text-muted py-5">No actors found.</div> }
</div>
<div class="mt-3"><partial name="_Pagination" /></div>
@section Scripts {
<script>
function confirmDelete(id, name, type) {
    document.getElementById('deleteModalBody').textContent = 'Delete ' + type + ': "' + name + '"?';
    document.getElementById('deleteForm').action = '/Admin/Actor/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>}
