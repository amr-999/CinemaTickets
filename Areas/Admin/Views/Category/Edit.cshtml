@model Category
@{ ViewData["Title"] = "Edit Category"; }
<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card card-section">
        <div class="card-header-section"><i class="fas fa-pen me-2 text-warning"></i>Edit Category</div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
