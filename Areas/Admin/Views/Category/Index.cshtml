@model CinemaTickets.Helpers.PaginatedList<CinemaTickets.Models.Category>
@{ ViewData["Title"] = "Categories"; }
<div class="card card-section mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search categories…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Category</a>
            </div>
        </form>
    </div>
</div>
<div class="card card-section">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th width="60">#</th><th>Name</th><th width="160" class="text-center">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td class="text-muted">@c.Id</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-pen"></i></a>
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="confirmDelete('@c.Id','@c.Name','Category')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">No categories found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0"><partial name="_Pagination" /></div>
</div>
@section Scripts {
<script>
function confirmDelete(id, name, type) {
    document.getElementById('deleteModalBody').textContent = 'Delete ' + type + ': "' + name + '"?';
    document.getElementById('deleteForm').action = '/Admin/Category/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>}
