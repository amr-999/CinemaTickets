@model CinemaTickets.ViewModels.HallVM
@{ ViewData["Title"] = "New Hall"; }
<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card card-section">
        <div class="card-header-section"><i class="fas fa-plus-circle me-2 text-primary"></i>Create Hall</div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger" style="display:none"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Screen 1, Hall A…" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CinemaId" class="form-label fw-semibold"></label>
                    <select asp-for="CinemaId" class="form-select" asp-items="Model.CinemaList">
                        <option value="">-- Select Cinema --</option>
                    </select>
                    <span asp-validation-for="CinemaId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TotalSeats" class="form-label fw-semibold"></label>
                    <input asp-for="TotalSeats" class="form-control" type="number" min="1" />
                    <span asp-validation-for="TotalSeats" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <input asp-for="Description" class="form-control" placeholder="e.g. IMAX Screen, Dolby Atmos…" />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
