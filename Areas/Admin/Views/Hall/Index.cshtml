@model CinemaTickets.Helpers.PaginatedList<CinemaTickets.Models.Hall>
@{ ViewData["Title"] = "Halls"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@ViewBag.TotalCount halls total</p>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Hall</a>
</div>

<div class="card card-section mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search halls…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-section">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th><th>Hall Name</th><th>Cinema</th>
                    <th>Total Seats</th><th>Description</th>
                    <th width="140" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Items)
                {
                    <tr>
                        <td class="text-muted">@h.Id</td>
                        <td class="fw-semibold">@h.Name</td>
                        <td><span class="badge bg-light text-dark border">@h.Cinema?.Name</span></td>
                        <td><i class="fas fa-couch text-muted me-1"></i>@h.TotalSeats</td>
                        <td class="text-muted small">@h.Description</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-pen"></i></a>
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="confirmDelete('@h.Id','@h.Name','Hall')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                { <tr><td colspan="6" class="text-center text-muted py-4">No halls found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0">
        <partial name="_Pagination" />
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, name, type) {
    document.getElementById('deleteModalBody').textContent = 'Delete ' + type + ': "' + name + '"?';
    document.getElementById('deleteForm').action = '/Admin/Hall/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>}
