@model Movie
@{ ViewData["Title"] = Model.Name; }

<div class="row g-4">

    <!-- LEFT: Poster + Info + Cast -->
    <div class="col-lg-4">
        <div class="card card-section mb-4">
            @if (!string.IsNullOrEmpty(Model.MainImg))
            {
                <img src="@Model.MainImg" class="card-img-top rounded-top"
                     style="object-fit:cover;max-height:400px" alt="@Model.Name" />
            }
            else
            {
                <div class="main-img-preview rounded-top" style="height:260px">
                    <i class="fas fa-film fa-4x text-muted"></i>
                </div>
            }
            <div class="card-body">
                <h4 class="fw-bold mb-2">@Model.Name</h4>
                <span class="@Model.Status.ToBadge() fs-6 mb-3 d-inline-block">
                    @Model.Status.ToDisplay()
                </span>
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted fw-semibold ps-0" width="85">Cinema</td>
                        <td>@Model.Cinema?.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold ps-0">Category</td>
                        <td><span class="badge bg-light text-dark border">@Model.Category?.Name</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold ps-0">Price</td>
                        <td class="text-success fw-bold fs-5">$@Model.Price.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold ps-0">Screening</td>
                        <td>@Model.DateTime.ToString("MMM dd, yyyy · HH:mm")</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning flex-fill">
                    <i class="fas fa-pen me-1"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                    <i class="fas fa-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>

        <!-- Cast -->
        @if (Model.MovieActors.Any())
        {
            <div class="card card-section">
                <div class="card-header-section">
                    <i class="fas fa-users me-2 text-primary"></i>Cast
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var ma in Model.MovieActors)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 px-3 py-2">
                            @if (!string.IsNullOrEmpty(ma.Actor?.Img))
                            {
                                <img src="@ma.Actor.Img" class="actor-photo-sm rounded-circle" alt="@ma.Actor?.Name" />
                            }
                            else
                            {
                                <div class="actor-photo-sm rounded-circle bg-light d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user text-secondary"></i>
                                </div>
                            }
                            <span class="fw-semibold">@ma.Actor?.Name</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    <!-- RIGHT: Synopsis + Gallery -->
    <div class="col-lg-8">
        <div class="card card-section mb-4">
            <div class="card-header-section">
                <i class="fas fa-align-left me-2 text-primary"></i>Synopsis
            </div>
            <div class="card-body">
                <p class="lh-lg fs-6 mb-0">@Model.Description</p>
            </div>
        </div>

        @if (Model.SubImages.Any())
        {
            <div class="card card-section">
                <div class="card-header-section">
                    <i class="fas fa-images me-2 text-primary"></i>
                    Gallery <span class="text-muted">(@Model.SubImages.Count photos)</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var si in Model.SubImages)
                        {
                            <div class="col-sm-6 col-md-4">
                                <a href="@si.Img" target="_blank">
                                    <img src="@si.Img" class="img-fluid rounded shadow-sm gallery-img" />
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card card-section">
                <div class="card-body text-center text-muted py-5">
                    <i class="fas fa-images fa-3x mb-3 opacity-25"></i>
                    <p class="mb-0">No gallery images yet.</p>
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-primary mt-3">
                        <i class="fas fa-plus me-1"></i>Add Images
                    </a>
                </div>
            </div>
        }
    </div>
</div>
