@model List<CinemaTickets.Models.Movie>
@{ ViewData["Title"] = "Movies"; }

<!-- Filter Bar -->
<div class="card card-section mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search movies…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="categoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="cinemaId" class="form-select form-select-sm" asp-items="ViewBag.Cinemas">
                    <option value="">All Cinemas</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    <option value="NowShowing" selected="@(ViewBag.Status=="NowShowing"?"selected":null)">Now Showing</option>
                    <option value="ComingSoon" selected="@(ViewBag.Status=="ComingSoon"?"selected":null)">Coming Soon</option>
                    <option value="Ended"      selected="@(ViewBag.Status=="Ended"     ?"selected":null)">Ended</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1"><i class="fas fa-rotate-left"></i></a>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Create" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Movie</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-section">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th width="60">Poster</th><th>Movie</th><th>Cinema</th><th>Hall</th>
                    <th>Category</th><th>Price</th><th>Seats</th><th>Status</th><th>Date</th>
                    <th width="120" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(m.MainImg))
                            { <img src="@m.MainImg" class="movie-thumb-sm" alt="@m.Name" /> }
                            else { <div class="movie-thumb-sm-placeholder"><i class="fas fa-film"></i></div> }
                        </td>
                        <td class="fw-semibold">@m.Name</td>
                        <td class="text-muted small">@m.Cinema?.Name</td>
                        <td class="text-muted small">@(m.Hall?.Name ?? "—")</td>
                        <td><span class="badge bg-light text-dark border">@m.Category?.Name</span></td>
                        <td class="fw-semibold text-success">$@m.Price.ToString("0.00")</td>
                        <td>
                            @if (m.AvailableSeats == 0)
                            { <span class="badge bg-danger">Sold Out</span> }
                            else
                            {
                                <span class="@(m.AvailableSeats <= 20 ? "text-warning" : "text-success") fw-semibold small">
                                    @m.AvailableSeats
                                    @if (m.Hall != null) { <text>/ @m.Hall.TotalSeats</text> }
                                </span>
                            }
                        </td>
                        <td><span class="@m.Status.ToBadge()">@m.Status.ToDisplay()</span></td>
                        <td class="text-muted small">@m.DateTime.ToString("MMM dd, yyyy")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-xs btn-outline-info" title="Details"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit"    asp-route-id="@m.Id" class="btn btn-xs btn-outline-warning" title="Edit"><i class="fas fa-pen"></i></a>
                            <button class="btn btn-xs btn-outline-danger" title="Delete"
                                    onclick="confirmDelete('@m.Id','@m.Name','Movie')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                { <tr><td colspan="10" class="text-center text-muted py-5">No movies found.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body pt-0">
        <partial name="_Pagination" />
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, name, type) {
    document.getElementById('deleteModalBody').textContent =
        'Delete ' + type + ': "' + name + '"? All data will be removed.';
    document.getElementById('deleteForm').action = '/Admin/Movie/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>}
