@model Movie
@{ ViewData["Title"] = Model.Name; }

<!-- ── HERO BANNER ─────────────────────────────────────── -->
<section class="detail-hero"
         style="@(!string.IsNullOrEmpty(Model.MainImg) ? $"background-image:url('{Model.MainImg}')" : "")">
    <div class="detail-hero-overlay"></div>
    <div class="container detail-hero-content">
        <a asp-area="Customer" asp-controller="Home" asp-action="Index"
           class="btn btn-outline-light btn-sm mb-4 rounded-pill">
            <i class="fas fa-arrow-left me-1"></i>Back to Movies
        </a>
        <div class="row align-items-end">
            <div class="col-auto d-none d-md-block">
                @if (!string.IsNullOrEmpty(Model.MainImg))
                {
                    <img src="@Model.MainImg" class="detail-poster shadow" alt="@Model.Name" />
                }
            </div>
            <div class="col">
                <span class="@Model.Status.ToBadge() fs-6 mb-2 d-inline-block">@Model.Status.ToDisplay()</span>
                <h1 class="detail-title">@Model.Name</h1>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    <span class="detail-tag"><i class="fas fa-tags me-1"></i>@Model.Category?.Name</span>
                    <span class="detail-tag"><i class="fas fa-building me-1"></i>@Model.Cinema?.Name</span>
                    @if (Model.Hall != null)
                    {
                        <span class="detail-tag"><i class="fas fa-door-open me-1"></i>@Model.Hall.Name</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── MAIN CONTENT ───────────────────────────────────── -->
<section class="detail-body">
    <div class="container">
        <div class="row g-5">

            <!-- LEFT: Synopsis + Cast + Gallery -->
            <div class="col-lg-8">

                <!-- Synopsis -->
                <div class="detail-card mb-4">
                    <h4 class="detail-card-title"><i class="fas fa-align-left me-2 text-accent"></i>Synopsis</h4>
                    <p class="lh-lg text-secondary mb-0">@Model.Description</p>
                </div>

                <!-- Cast -->
                @if (Model.MovieActors.Any())
                {
                    <div class="detail-card mb-4">
                        <h4 class="detail-card-title"><i class="fas fa-users me-2 text-accent"></i>Cast</h4>
                        <div class="row g-3">
                            @foreach (var ma in Model.MovieActors)
                            {
                                <div class="col-6 col-sm-4 col-md-3">
                                    <div class="cast-card text-center">
                                        @if (!string.IsNullOrEmpty(ma.Actor?.Img))
                                        {
                                            <img src="@ma.Actor.Img" class="cast-photo" alt="@ma.Actor?.Name" />
                                        }
                                        else
                                        {
                                            <div class="cast-photo-placeholder">
                                                <i class="fas fa-user fa-2x"></i>
                                            </div>
                                        }
                                        <p class="cast-name mt-2 mb-0">@ma.Actor?.Name</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Gallery -->
                @if (Model.SubImages.Any())
                {
                    <div class="detail-card">
                        <h4 class="detail-card-title">
                            <i class="fas fa-images me-2 text-accent"></i>Gallery
                            <small class="text-secondary fs-6">(@Model.SubImages.Count photos)</small>
                        </h4>
                        <div class="row g-3">
                            @foreach (var si in Model.SubImages)
                            {
                                <div class="col-sm-6 col-md-4">
                                    <a href="@si.Img" target="_blank">
                                        <img src="@si.Img" class="gallery-img rounded" alt="gallery" />
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT: Booking Info Card -->
            <div class="col-lg-4">
                <div class="booking-card sticky-top" style="top:20px">
                    <div class="booking-price-banner">
                        <span class="booking-price">$@Model.Price.ToString("0.00")</span>
                        <span class="text-secondary small">per ticket</span>
                    </div>

                    <div class="booking-info-list">
                        <div class="booking-info-row">
                            <span class="bi-label"><i class="fas fa-calendar-day text-accent"></i>Date</span>
                            <span class="bi-value">@Model.DateTime.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="booking-info-row">
                            <span class="bi-label"><i class="fas fa-clock text-accent"></i>Time</span>
                            <span class="bi-value fw-bold">@Model.DateTime.ToString("HH:mm")</span>
                        </div>
                        <div class="booking-info-row">
                            <span class="bi-label"><i class="fas fa-building text-accent"></i>Cinema</span>
                            <span class="bi-value">@Model.Cinema?.Name</span>
                        </div>
                        @if (Model.Cinema?.Location != null)
                        {
                            <div class="booking-info-row">
                                <span class="bi-label"><i class="fas fa-location-dot text-accent"></i>Location</span>
                                <span class="bi-value">@Model.Cinema.Location</span>
                            </div>
                        }
                        @if (Model.Hall != null)
                        {
                            <div class="booking-info-row">
                                <span class="bi-label"><i class="fas fa-door-open text-accent"></i>Hall</span>
                                <span class="bi-value">@Model.Hall.Name</span>
                            </div>
                            <div class="booking-info-row">
                                <span class="bi-label"><i class="fas fa-couch text-accent"></i>Capacity</span>
                                <span class="bi-value">@Model.Hall.TotalSeats total seats</span>
                            </div>
                        }
                        <div class="booking-info-row">
                            <span class="bi-label"><i class="fas fa-ticket text-accent"></i>Available</span>
                            <span class="bi-value">
                                @if (Model.AvailableSeats == 0)
                                {
                                    <span class="badge bg-danger">Sold Out</span>
                                }
                                else if (Model.AvailableSeats <= 20)
                                {
                                    <span class="text-warning fw-bold">Only @Model.AvailableSeats seats left!</span>
                                }
                                else
                                {
                                    <span class="text-success fw-semibold">@Model.AvailableSeats seats available</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Seat progress bar -->
                    @if (Model.Hall != null && Model.Hall.TotalSeats > 0)
                    {
                        var pct = (int)((double)Model.AvailableSeats / Model.Hall.TotalSeats * 100);
                        var barColor = pct > 50 ? "bg-success" : pct > 20 ? "bg-warning" : "bg-danger";
                        <div class="px-3 pb-2">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                <span>@(Model.Hall.TotalSeats - Model.AvailableSeats) booked</span>
                                <span>@Model.AvailableSeats free</span>
                            </div>
                            <div class="progress" style="height:8px;border-radius:6px">
                                <div class="progress-bar @barColor" style="width:@pct%"></div>
                            </div>
                        </div>
                    }

                    <div class="p-3">
                        @if (Model.AvailableSeats > 0 && Model.Status != MovieStatus.Ended)
                        {
                            <button class="btn btn-accent w-100 btn-lg fw-bold">
                                <i class="fas fa-ticket me-2"></i>Book Now
                            </button>
                            <p class="text-center text-secondary small mt-2 mb-0">
                                Secure your seat before it's gone!
                            </p>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100 btn-lg" disabled>
                                <i class="fas fa-ban me-2"></i>
                                @(Model.Status == MovieStatus.Ended ? "Screening Ended" : "Sold Out")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
