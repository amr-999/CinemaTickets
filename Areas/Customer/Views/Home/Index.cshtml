@model IEnumerable<Movie>
@{ ViewData["Title"] = "Movies"; }

<!-- ── HERO ─────────────────────────────────────────────── -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <h1 class="hero-title"><i class="fas fa-film me-3"></i>Book Your Cinema Experience</h1>
        <p class="hero-sub">@ViewBag.TotalCount movie@(ViewBag.TotalCount == 1 ? "" : "s") available · Browse and book your seat today</p>
    </div>
</section>

<!-- ── FILTER BAR ────────────────────────────────────────── -->
<section class="filter-section">
    <div class="container">
        <form method="get" asp-area="Customer" asp-controller="Home" asp-action="Index"
              class="filter-form row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text filter-icon"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control filter-input"
                           placeholder="Search movies…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="categoryId" class="form-select filter-select">
                    <option value="">All Genres</option>
                    @foreach (SelectListItem item in ViewBag.Categories)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == ViewBag.CategoryId?.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="cinemaId" class="form-select filter-select">
                    <option value="">All Cinemas</option>
                    @foreach (SelectListItem item in ViewBag.Cinemas)
                    {
                        <option value="@item.Value"
                                selected="@(item.Value == ViewBag.CinemaId?.ToString() ? "selected" : null)">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="status" class="form-select filter-select">
                    <option value="">All Status</option>
                    <option value="NowShowing"  selected="@(ViewBag.Status=="NowShowing"  ? "selected":null)">Now Showing</option>
                    <option value="ComingSoon"  selected="@(ViewBag.Status=="ComingSoon"  ? "selected":null)">Coming Soon</option>
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-accent flex-fill">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                   class="btn btn-outline-light flex-fill">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</section>

<!-- ── MOVIE GRID ─────────────────────────────────────────── -->
<section class="movies-section">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-film-slash fa-4x mb-3 opacity-25"></i>
                <h4>No movies found</h4>
                <p class="text-secondary">Try adjusting your filters or search term.</p>
                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                   class="btn btn-accent">Clear Filters</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var m in Model)
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="movie-card h-100">
                            <!-- Poster -->
                            <div class="movie-poster-wrap">
                                @if (!string.IsNullOrEmpty(m.MainImg))
                                {
                                    <img src="@m.MainImg" class="movie-poster" alt="@m.Name" />
                                }
                                else
                                {
                                    <div class="movie-poster-placeholder">
                                        <i class="fas fa-film fa-3x"></i>
                                    </div>
                                }
                                <span class="poster-badge @m.Status.ToBadge()">@m.Status.ToDisplay()</span>
                            </div>

                            <!-- Body -->
                            <div class="movie-card-body">
                                <h5 class="movie-title">@m.Name</h5>
                                <span class="genre-tag">@m.Category?.Name</span>

                                <div class="movie-meta mt-3">
                                    <div class="meta-row">
                                        <i class="fas fa-building text-accent"></i>
                                        <span>@m.Cinema?.Name</span>
                                    </div>
                                    @if (m.Hall != null)
                                    {
                                        <div class="meta-row">
                                            <i class="fas fa-door-open text-accent"></i>
                                            <span>@m.Hall.Name</span>
                                        </div>
                                    }
                                    <div class="meta-row">
                                        <i class="fas fa-calendar-day text-accent"></i>
                                        <span>@m.DateTime.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="meta-row">
                                        <i class="fas fa-clock text-accent"></i>
                                        <span>@m.DateTime.ToString("HH:mm")</span>
                                    </div>
                                    <div class="meta-row @(m.AvailableSeats <= 20 && m.AvailableSeats > 0 ? "seats-low" : "")">
                                        <i class="fas fa-couch text-accent"></i>
                                        <span>
                                            @if (m.AvailableSeats == 0)
                                            { <span class="text-danger fw-bold">Sold Out</span> }
                                            else if (m.Hall != null)
                                            { @($"{m.AvailableSeats} / {m.Hall.TotalSeats} seats available") }
                                            else
                                            { @($"{m.AvailableSeats} seats available") }
                                        </span>
                                    </div>
                                </div>

                                <div class="movie-card-footer">
                                    <span class="ticket-price">$@m.Price.ToString("0.00")</span>
                                    <a asp-area="Customer" asp-controller="Home"
                                       asp-action="Details" asp-route-id="@m.Id"
                                       class="btn btn-accent btn-sm">
                                        <i class="fas fa-circle-info me-1"></i>Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- ── Pagination ── -->
            @if ((int)ViewBag.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center" aria-label="pagination">
                    <ul class="pagination cust-pagination">
                        <li class="page-item @((int)ViewBag.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-area="Customer" asp-controller="Home" asp-action="Index"
                               asp-route-page="@((int)ViewBag.Page - 1)"
                               asp-route-search="@ViewBag.Search"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-cinemaId="@ViewBag.CinemaId"
                               asp-route-status="@ViewBag.Status">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                                <a class="page-link" asp-area="Customer" asp-controller="Home" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-cinemaId="@ViewBag.CinemaId"
                                   asp-route-status="@ViewBag.Status">@i</a>
                            </li>
                        }
                        <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-area="Customer" asp-controller="Home" asp-action="Index"
                               asp-route-page="@((int)ViewBag.Page + 1)"
                               asp-route-search="@ViewBag.Search"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-cinemaId="@ViewBag.CinemaId"
                               asp-route-status="@ViewBag.Status">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <p class="text-center text-secondary small">
                    Showing page @ViewBag.Page of @ViewBag.TotalPages
                    (@ViewBag.TotalCount total movies)
                </p>
            }
        }
    </div>
</section>
