<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – CinemaTickets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/customer.css" rel="stylesheet" />
</head>
<body>

<!-- ── Navbar ───────────────────────────────────────────── -->
<nav class="navbar navbar-expand-lg cust-navbar">
    <div class="container">
        <a class="navbar-brand cust-brand" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <i class="fas fa-film me-2"></i>CinemaTickets
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navMenu">
            <i class="fas fa-bars text-white"></i>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link cust-link" asp-area="Customer" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-house me-1"></i>Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link cust-link"
                       asp-area="Customer" asp-controller="Home" asp-action="Index"
                       asp-route-status="NowShowing">
                        <i class="fas fa-circle-play me-1"></i>Now Showing
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link cust-link"
                       asp-area="Customer" asp-controller="Home" asp-action="Index"
                       asp-route-status="ComingSoon">
                        <i class="fas fa-calendar-days me-1"></i>Coming Soon
                    </a>
                </li>
                <li class="nav-item ms-lg-2">
                    <a class="btn btn-sm btn-outline-light rounded-pill px-3"
                       asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-shield-halved me-1"></i>Admin
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ── Page Content ─────────────────────────────────────── -->
<main>@RenderBody()</main>

<!-- ── Footer ───────────────────────────────────────────── -->
<footer class="cust-footer mt-auto">
    <div class="container py-4 text-center">
        <p class="mb-1 fw-semibold"><i class="fas fa-film me-2"></i>CinemaTickets</p>
        <p class="small text-secondary mb-0">&copy; @DateTime.Now.Year CinemaTickets. All rights reserved.</p>
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
