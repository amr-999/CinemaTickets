@* Usage: ViewBag.Page, ViewBag.TotalPages, plus route values passed via ViewBag *@
@if ((int)ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3 px-1">
        <small class="text-muted">
            Showing page @ViewBag.Page of @ViewBag.TotalPages
            (@ViewBag.TotalCount records)
        </small>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @((int)ViewBag.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@((int)ViewBag.Page - 1)&search=@ViewBag.Search&categoryId=@ViewBag.CategoryId&cinemaId=@ViewBag.CinemaId&status=@ViewBag.Status">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search&categoryId=@ViewBag.CategoryId&cinemaId=@ViewBag.CinemaId&status=@ViewBag.Status">@i</a>
                    </li>
                }
                <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@((int)ViewBag.Page + 1)&search=@ViewBag.Search&categoryId=@ViewBag.CategoryId&cinemaId=@ViewBag.CinemaId&status=@ViewBag.Status">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
